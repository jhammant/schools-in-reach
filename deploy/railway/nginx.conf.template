server {
  listen ${PORT};
  root /usr/share/nginx/html;
  # Behind Railway's proxy nginx only sees http on $PORT; an absolute directory redirect
  # (/school/x -> /school/x/) would send visitors to http://host:8080/. Keep it relative.
  absolute_redirect off;

  # The per-council JSON and GeoJSON files compress very well.
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types application/json application/geo+json application/javascript text/css image/svg+xml text/plain application/octet-stream;

  location ~* \.geojson$ { default_type application/geo+json; add_header Cache-Control "public, max-age=3600"; }
  location /data/ { add_header Cache-Control "public, max-age=3600"; }
  location ~* \.(js|css)$ { add_header Cache-Control "public, max-age=300"; }
  location ~* \.xml$ { add_header Cache-Control "public, max-age=3600"; }
  location = /health { default_type text/plain; }
  # HTML must never be cached by browsers, or people keep seeing yesterday's page after a deploy.
  location ~* \.html$ { add_header Cache-Control "no-cache, must-revalidate"; }
  location = / { add_header Cache-Control "no-cache, must-revalidate"; try_files /index.html =404; }
  location /school/ { add_header Cache-Control "no-cache, must-revalidate"; try_files $uri $uri/ =404; }
  location /council/ { add_header Cache-Control "no-cache, must-revalidate"; try_files $uri $uri/ =404; }
  location / { try_files $uri $uri/ =404; }
}
