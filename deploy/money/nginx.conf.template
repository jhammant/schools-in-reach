server {
  listen ${PORT};
  root /usr/share/nginx/html;
  # Behind Railway's proxy nginx only sees http on $PORT; an absolute directory redirect
  # (/school/x -> /school/x/) would send visitors to http://host:8080/. Keep it relative.
  absolute_redirect off;

  # Per-school and per-area JSON, the search index and the app bundle compress very well.
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types application/json application/geo+json application/javascript text/css image/svg+xml text/plain application/xml text/xml;

  error_page 404 /404.html;
  location = /health { default_type text/plain; return 200 "ok\n"; }

  # Asset URLs are not versioned (/assets/app.js), so a long immutable cache would pin old JS/CSS
  # against new HTML after a deploy. Revalidate after five minutes; serve stale while doing so.
  # Data files can be an hour stale; HTML never.
  location /assets/ { add_header Cache-Control "public, max-age=300, stale-while-revalidate=86400"; try_files $uri =404; }
  location /data/ { add_header Cache-Control "public, max-age=3600"; try_files $uri =404; }
  location ~* \.geojson$ { default_type application/geo+json; add_header Cache-Control "public, max-age=3600"; }
  location ~* \.xml$ { add_header Cache-Control "public, max-age=3600"; }
  location ~* \.html$ { add_header Cache-Control "no-cache, must-revalidate"; }
  location = / { add_header Cache-Control "no-cache, must-revalidate"; try_files /index.html =404; }
  location / { add_header Cache-Control "no-cache, must-revalidate"; try_files $uri $uri/ =404; }
}
